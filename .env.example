# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Solo en PRE y PROD (32 caracteres o más, aleatorio). En local déjalo sin definir: se usa un valor de
# desarrollo. Una línea JWT_SECRETO= vacía anularía ese valor y el backend no arrancaría.
# JWT_SECRETO=
GOOGLE_CLIENT_ID=
# SCRUM-92: llave SECRETA de Cloudflare Turnstile. Vacía = la verificación de bots queda apagada. Para probar sin
# cuenta, Cloudflare publica llaves de prueba: 1x0000000000000000000000000000000AA siempre acepta y
# 2x0000000000000000000000000000000AA siempre rechaza.
TURNSTILE_SECRETO=
# RF10: avisos con Web Push (llegan aunque la aplicación esté cerrada). Vacíos = los avisos solo se ven dentro de la
# aplicación. Se generan una vez (ver el README, «Avisos»); la privada es SECRETA. VAPID_SUJETO es quién responde por
# el servidor: un correo (mailto:alguien@ejemplo.com) o una dirección https.
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_SUJETO=
# Opcionales: cada cuánto corre la tarea de avisos y cuánto espera tras arrancar (PT5M y PT1M por defecto)
# AVISOS_CADA=PT5M
# AVISOS_ESPERA_INICIAL=PT1M
# Correo del código de verificación. Vacío en local = el código sale en la consola del backend (o, con docker-compose.correo.yml, en Mailpit: http://localhost:8025).
# Gmail: CORREO_SMTP_HOST=smtp.gmail.com, el usuario es la cuenta completa y la clave es una
# "contraseña de aplicación" de 16 letras sin espacios (requiere verificación en dos pasos).
CORREO_SMTP_HOST=
CORREO_SMTP_USUARIO=
CORREO_SMTP_CLAVE=
# Opcionales: puerto (587 por defecto) y remitente (por defecto, el mismo usuario)
# CORREO_SMTP_PUERTO=587
# CORREO_REMITENTE=
VAPID_PUBLICA=
VAPID_PRIVADA=
# No es secreto (solo dice qué origen puede llamar a la API); trae el valor de DEV para que
# el backend local funcione con Angular sin configurar nada más. En PRE y PROD se sobreescribe.
CORS_ORIGENES=http://localhost:4200
# Solo desarrollo: permite que Postman envie la cookie de refresco por http. PRE y PROD usan true (por defecto).
COOKIE_SECURE=false

# Solo si usas pgAdmin (docker compose --profile herramientas up -d). No hay clave por defecto y el
# contenedor se niega a arrancar sin ella. pgAdmin corre en modo servidor, así que pedirá este correo
# y esta clave al entrar en http://localhost:8081: es una consola con acceso total a la base.
# PGADMIN_PASSWORD=

# Solo para "docker compose --profile app up --build", que construye el frontend desde su repositorio.
# Por defecto el hermano de este (../Frontend), que es como están clonados. Defínela si están en otra
# parte, por ejemplo al construir desde un worktree o en un CI que clona un solo repositorio.
# RUTA_FRONTEND=../Frontend

# SCRUM-71: cuantos proxies hay delante de la aplicacion (0 = ninguno, en local; 1 = balanceador; 2 = CloudFront y
# balanceador). En AWS lo pone la plantilla; solo hace falta aqui si pruebas detras de un proxy propio.
# SALTOS_DE_PROXY=
