# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Solo en PRE y PROD (32 caracteres o más, aleatorio). En local déjalo sin definir: se usa un valor de
# desarrollo. Una línea JWT_SECRETO= vacía anularía ese valor y el backend no arrancaría.
# JWT_SECRETO=
GOOGLE_CLIENT_ID=
# Correo del código de verificación. Vacío en local = el código sale en la consola del backend.
# Gmail: CORREO_SMTP_HOST=smtp.gmail.com, el usuario es la cuenta completa y la clave es una
# "contraseña de aplicación" de 16 letras sin espacios (requiere verificación en dos pasos).
CORREO_SMTP_HOST=
CORREO_SMTP_USUARIO=
CORREO_SMTP_CLAVE=
# Opcionales: puerto (587 por defecto) y remitente (por defecto, el mismo usuario)
# CORREO_SMTP_PUERTO=587
# CORREO_REMITENTE=
VAPID_PUBLICA=
VAPID_PRIVADA=
# No es secreto (solo dice qué origen puede llamar a la API); trae el valor de DEV para que
# el backend local funcione con Angular sin configurar nada más. En PRE y PROD se sobreescribe.
CORS_ORIGENES=http://localhost:4200
# Solo desarrollo: permite que Postman envie la cookie de refresco por http. PRE y PROD usan true (por defecto).
COOKIE_SECURE=false
